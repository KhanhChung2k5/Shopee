<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent aggregator tạm thời khi teammate chưa có POM gốc.
  Chỉ khai báo modules/crm — không tạo modules/marketing.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.chototmua</groupId>
    <artifactId>chototmua-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Chợ Tốt Mua</name>
    <description>Aggregator monolith — CRM là module đầu tiên trên repo này.</description>

    <modules>
        <module>modules/crm</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
